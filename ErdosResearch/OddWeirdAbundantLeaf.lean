/-!
# A cheap Lean leaf for abundant prefixes: explicit pseudoperfect certificates

Reference: <https://www.erdosproblems.com/470>. See `notes/erdos-470.md` (session 62).

In the ω = 6 family search, a 5-prime prefix `N` that is already abundant is not handled by the
last-prime plan decider (`not_weird_mul_prime_of_lastOK`); instead `N` itself has to be
pseudoperfect, and then no multiple of `N` is weird (`Nat.Pseudoperfect.of_dvd`).
`ppOK n l` is a Boolean check that `l` is a strictly decreasing list of proper divisors of `n`
with sum `n`; the kernel evaluates it with GMP arithmetic only (no divisor enumeration of `n`).
`scripts/abundant_greedy_probe.py` finds such lists (greedy plus an exact subset-sum finish) for
every sampled abundant prefix shaped like the open roots (500/500).

* `pseudoperfect_of_ppOK`: soundness.
* `pseudoperfect_real_abundant_node`: the abundant node `3^18·5^17·19^2·97^3·2647` from the
  ω = 6 worker log is pseudoperfect (241 divisors), so no multiple of it is weird.

Elementary; new only as a formalisation.
-/

namespace ErdosResearch.OddWeirdAbundantLeaf

/-- The list is strictly decreasing. -/
def descOK : List ℕ → Bool
  | a :: b :: t => decide (b < a) && descOK (b :: t)
  | _ => true

theorem pairwise_of_descOK : ∀ l : List ℕ, descOK l = true → l.Pairwise (· > ·)
  | [], _ => .nil
  | [_], _ => List.pairwise_singleton _ _
  | a :: b :: t, h => by
    simp only [descOK, Bool.and_eq_true, decide_eq_true_eq] at h
    have ih := pairwise_of_descOK (b :: t) h.2
    refine List.Pairwise.cons ?_ ih
    intro x hx
    rcases List.mem_cons.1 hx with rfl | hx
    · exact h.1
    · exact lt_trans (List.rel_of_pairwise_cons ih hx) h.1

/-- `l` is a strictly decreasing list of proper divisors of `n` with sum `n`. -/
def ppOK (n : ℕ) (l : List ℕ) : Bool :=
  descOK l && l.all (fun d => decide (d < n) && n % d == 0) && l.sum == n

theorem pseudoperfect_of_ppOK {n : ℕ} {l : List ℕ} (h : ppOK n l = true) (hn : 0 < n) :
    n.Pseudoperfect := by
  simp only [ppOK, Bool.and_eq_true, List.all_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  obtain ⟨⟨hd, hall⟩, hs⟩ := h
  have hnd : l.Nodup := (pairwise_of_descOK l hd).imp (fun h => ne_of_gt h)
  refine ⟨hn, l.toFinset, ?_, ?_⟩
  · intro d hd'
    rw [List.mem_toFinset] at hd'
    obtain ⟨hlt, hdv⟩ := hall d hd'
    exact Nat.mem_properDivisors.2 ⟨Nat.dvd_of_mod_eq_zero hdv, hlt⟩
  · rw [List.sum_toFinset _ hnd]
    simpa using hs

