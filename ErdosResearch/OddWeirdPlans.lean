theorem cert39_gap3 :
    gapCertM fs39_3 5 26003211284306388033885 = true := by
  decide +kernel

theorem cert39_raise3 :
    raiseOK (prodOf fs39_3) 23 1 84399 5 26003211284306388033885 672045776955348179610115 1 = true ∧
    raiseSum (prodOf fs39_3) 23 1 26003211284306388033885 672045776955348179610115 1 = 15531024787389309385863405 ∧
    prodOf fs39_3 * 23 ^ (1 + 1) = 5 ^ 8 * 11 ^ 8 * 17 ^ 4 * 19 ^ 3 * 23 ^ 2 ∧
