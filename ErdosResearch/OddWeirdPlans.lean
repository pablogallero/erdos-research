    (by norm_num) hs hSB1 hgB1 h1ok
  rw [h1rs, h1n] at hr1
  clear hs
  have hs := hr1
  obtain ⟨h2ok, h2rs, h2n, h2m0, h2mp⟩ := cert38_raise2
  obtain ⟨hSB2, hgB2⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs38_2]) cert38_gap2
  have hr2 := intervalGap_raise h2m0 (by norm_num) (fun h => h2mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB2 hgB2 h2ok
  rw [h2rs, h2n] at hr2
  clear hs
  have hs := hr2
  obtain ⟨h3ok, h3rs, h3n, h3m0, h3mp⟩ := cert38_raise3
  obtain ⟨hSB3, hgB3⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs38_3]) cert38_gap3
  have hr3 := intervalGap_raise h3m0 (by norm_num) (fun h => h3mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB3 hgB3 h3ok
  rw [h3rs, h3n] at hr3
  clear hs
  have hs := hr3
  exact not_weird_mul_prime_of_lastOK (by norm_num) (by norm_num) hs cert38_last hq hqn

/-- Factorisation of the base `898909` (its proper divisors are `baseList fsb39`). -/
def fsb39 : List (ℕ × ℕ) := [(11, 2), (17, 1), (19, 1), (23, 1)]

/-- Cofactor of raise 1 (prime `11`). -/
def fs39_0 : List (ℕ × ℕ) := [(5, 8), (17, 1), (19, 1), (23, 1)]

/-- Cofactor of raise 2 (prime `17`). -/
def fs39_1 : List (ℕ × ℕ) := [(5, 8), (11, 8), (19, 1), (23, 1)]

/-- Cofactor of raise 3 (prime `19`). -/
def fs39_2 : List (ℕ × ℕ) := [(5, 8), (11, 8), (17, 4), (23, 1)]

/-- Cofactor of raise 4 (prime `23`). -/
def fs39_3 : List (ℕ × ℕ) := [(5, 8), (11, 8), (17, 4), (19, 3)]

theorem cert39_base :
    baseOK fsb39 = true ∧
    prodOf fsb39 = 898909 ∧
    intervalOKB (ssBits (baseList fsb39)) 84399 (baseList fsb39).sum = true ∧
    gapOKB (ssBits (baseList fsb39)) 9862 (baseList fsb39).sum = true ∧
    stepsOK 84399 9862 898909 (baseList fsb39).sum [(5, 8)] = true ∧
    stepsEnd 898909 (baseList fsb39).sum [(5, 8)] = (prodOf fs39_0 * 11 ^ 2, 209957134595) := by
  decide +kernel

theorem cert39_gap0 :
    gapCertM fs39_0 11 1316794715 = true := by
  decide +kernel

theorem cert39_raise0 :
    raiseOK (prodOf fs39_0) 11 2 84399 11 1316794715 209957134595 6 = true ∧
    raiseSum (prodOf fs39_0) 11 2 1316794715 209957134595 6 = 372699247812595835 ∧
    prodOf fs39_0 * 11 ^ (2 + 6) = prodOf fs39_1 * 17 ^ 1 ∧
    0 < prodOf fs39_0 ∧
    prodOf fs39_0 % 11 ≠ 0 := by
  decide +kernel

theorem cert39_gap1 :
    gapCertM fs39_1 5 18672639830799595 = true := by
  decide +kernel

theorem cert39_raise1 :
    raiseOK (prodOf fs39_1) 17 1 84399 5 18672639830799595 372699247812595835 3 = true ∧
    raiseSum (prodOf fs39_1) 17 1 18672639830799595 372699247812595835 3 = 1848037566304807172395 ∧
    prodOf fs39_1 * 17 ^ (1 + 3) = prodOf fs39_2 * 19 ^ 1 ∧
    0 < prodOf fs39_1 ∧
    prodOf fs39_1 % 17 ≠ 0 := by
