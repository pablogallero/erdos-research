/-- **No `5 ^ 8 * 11 ^ 8 * 17 ^ 4 * 19 ^ 3 * 23 ^ 2 · q` is weird** (`q` prime, `q ∤` prefix): base `898909` (`c = 84399`, `g = 9862`), steps `5^8`, raises `11` to `11^8`, `17` to `17^4`, `19` to `19^3`, `23` to `23^2`, last primes `q < 5`. -/
theorem not_weird_39 {q : ℕ} (hq : q.Prime) (hqn : ¬ q ∣ 5 ^ 8 * 11 ^ 8 * 17 ^ 4 * 19 ^ 3 * 23 ^ 2) :
    ¬ (5 ^ 8 * 11 ^ 8 * 17 ^ 4 * 19 ^ 3 * 23 ^ 2 * q).Weird := by
  obtain ⟨hbo, hpb, hI, hG, hst, hend⟩ := cert39_base
  obtain ⟨hl, hnd⟩ := baseList_properDivisors (by norm_num [fsb39]) hbo
  have h0 := intervalGap_of_bitsB (baseList fsb39) hl hnd hI hG
  rw [hpb] at h0
  have hs := intervalGap_of_stepsOK (by norm_num) [(5, 8)] _ _ (by norm_num) (by norm_num) hst h0
  rw [hend] at hs
  obtain ⟨h0ok, h0rs, h0n, h0m0, h0mp⟩ := cert39_raise0
  obtain ⟨hSB0, hgB0⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs39_0]) cert39_gap0
  have hr0 := intervalGap_raise h0m0 (by norm_num) (fun h => h0mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB0 hgB0 h0ok
  rw [h0rs, h0n] at hr0
  clear hs
  have hs := hr0
  obtain ⟨h1ok, h1rs, h1n, h1m0, h1mp⟩ := cert39_raise1
  obtain ⟨hSB1, hgB1⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs39_1]) cert39_gap1
  have hr1 := intervalGap_raise h1m0 (by norm_num) (fun h => h1mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB1 hgB1 h1ok
  rw [h1rs, h1n] at hr1
  clear hs
  have hs := hr1
  obtain ⟨h2ok, h2rs, h2n, h2m0, h2mp⟩ := cert39_raise2
  obtain ⟨hSB2, hgB2⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs39_2]) cert39_gap2
  have hr2 := intervalGap_raise h2m0 (by norm_num) (fun h => h2mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB2 hgB2 h2ok
  rw [h2rs, h2n] at hr2
  clear hs
  have hs := hr2
  obtain ⟨h3ok, h3rs, h3n, h3m0, h3mp⟩ := cert39_raise3
  obtain ⟨hSB3, hgB3⟩ := gap_properDivisors_of_gapCertM (by norm_num [fs39_3]) cert39_gap3
  have hr3 := intervalGap_raise h3m0 (by norm_num) (fun h => h3mp (Nat.mod_eq_zero_of_dvd h))
    (by norm_num) hs hSB3 hgB3 h3ok
  rw [h3rs, h3n] at hr3
  clear hs
  have hs := hr3
  exact not_weird_mul_prime_of_lastOK (by norm_num) (by norm_num) hs cert39_last hq hqn

