theorem cert39_gap2 :
    gapCertM fs39_2 5 84359304754693034401 = true := by
  decide +kernel

theorem cert39_raise2 :
    raiseOK (prodOf fs39_2) 19 1 84399 5 84359304754693034401 1848037566304807172395 2 = true ∧
    raiseSum (prodOf fs39_2) 19 1 84359304754693034401 1848037566304807172395 2 = 672045776955348179610115 ∧
    prodOf fs39_2 * 19 ^ (1 + 2) = prodOf fs39_3 * 23 ^ 1 ∧
