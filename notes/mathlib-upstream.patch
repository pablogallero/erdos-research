+theorem Pseudoperfect.pos (h : Pseudoperfect n) : 0 < n := h.1
+
+/-- A nonzero multiple of a pseudoperfect number is pseudoperfect. -/
+theorem Pseudoperfect.of_dvd (h : Pseudoperfect m) (hd : m ∣ n) (hn : n ≠ 0) :
+    Pseudoperfect n := by
+  obtain ⟨-, s, hs, hsum⟩ := h
+  obtain ⟨k, rfl⟩ := hd
+  have hk : 0 < k := Nat.pos_of_ne_zero (by rintro rfl; simp at hn)
+  refine ⟨Nat.pos_of_ne_zero hn, s.image (· * k), fun x hx ↦ ?_, ?_⟩
+  · obtain ⟨i, hi, rfl⟩ := mem_image.mp hx
+    obtain ⟨hdvd, hlt⟩ := mem_properDivisors.mp (hs hi)
+    exact mem_properDivisors.mpr ⟨Nat.mul_dvd_mul_right hdvd k, Nat.mul_lt_mul_of_pos_right hlt hk⟩
+  · rw [sum_image fun x _ y _ hxy ↦ Nat.eq_of_mul_eq_mul_right hk hxy, ← sum_mul, hsum]
+
+theorem Pseudoperfect.mul_left (h : Pseudoperfect n) (hm : m ≠ 0) : Pseudoperfect (m * n) :=
+  h.of_dvd (Nat.dvd_mul_left n m) (mul_ne_zero hm h.pos.ne')
+
+theorem Pseudoperfect.not_deficient (h : Pseudoperfect n) : ¬ Deficient n := by
+  obtain ⟨-, s, hs, hsum⟩ := h
+  have := sum_le_sum_of_subset (f := id) hs
+  simp only [id] at this
+  unfold Deficient
+  omega
+
+theorem Deficient.not_pseudoperfect (h : Deficient n) : ¬ Pseudoperfect n :=
+  fun hp ↦ hp.not_deficient h
+
+theorem Deficient.not_weird (h : Deficient n) : ¬ Weird n := fun hw ↦ by
+  have := hw.1
+  unfold Deficient at h
+  unfold Abundant at this
+  omega
+
+theorem Perfect.not_weird (h : Perfect n) : ¬ Weird n :=
+  fun hw ↦ hw.2 h.pseudoperfect
+
+/-- No divisor of a weird number is pseudoperfect. -/
+theorem Weird.not_pseudoperfect_of_dvd (h : Weird n) (hd : m ∣ n) : ¬ Pseudoperfect m :=
+  fun hm ↦ h.2 (hm.of_dvd hd h.pos.ne')
+
+/-- A number that is not deficient and whose proper divisors satisfy the chain condition of
+`Finset.mem_subsetSum_of_chain` is pseudoperfect. -/
+theorem pseudoperfect_of_chain (hn : n ≠ 0)
+    (hc : ∀ d ∈ n.properDivisors, d ≤ ∑ e ∈ n.properDivisors with e < d, e + 1)
+    (hd : ¬ Deficient n) : Pseudoperfect n := by
+  unfold Deficient at hd
+  exact ⟨Nat.pos_of_ne_zero hn, mem_subsetSum_iff.mp (mem_subsetSum_of_chain _ hc (by omega))⟩
+
